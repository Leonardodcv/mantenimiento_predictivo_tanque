# API
APP_NAME=Mantenimiento Predictivo API v2
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8002
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Fuente: file para demo, sqlserver para produccion.
DATA_SOURCE=file
DATA_FILE=data/lecturas_mixtas_demo.tsv

# 0 = cargar TODA la tabla durante /model/rebuild/.
MODEL_MAX_ROWS=0
LATEST_CONTEXT_ROWS=2000
ANOMALY_DEFAULT_LIMIT=500
CYCLE_DEFAULT_LIMIT=20

# Motor
MOVEMENT_SPEED_THRESHOLD=20
STABLE_SPEED_THRESHOLD=1100
POST_STOP_SECONDS=10
STARTUP_GRACE_SECONDS=5
PRESSURE_WARNING_PERSISTENT_SECONDS=15

# SQL Server
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_SERVER=10.10.17.13
SQL_PORT=1433
SQL_DATABASE=MantenimientoPredictivo
SQL_TABLE=dbo.LecturasTanque
SQL_USERNAME=
SQL_PASSWORD=
SQL_ENCRYPT=no
SQL_TRUST_SERVER_CERTIFICATE=yes
SQL_CONNECTION_TIMEOUT=8
SQL_QUERY_TIMEOUT=60
