# ============================================================
# MANTENIMIENTO PREDICTIVO DEL TANQUE - BACKEND v2.2
# ============================================================

# API
APP_NAME=Mantenimiento Predictivo Tanque API v2.2
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8002

# Origenes permitidos para el frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5174,http://127.0.0.1:5174,http://10.10.17.13:5174,http://10.10.17.17:5174

# Fuente de datos
# file      = archivo demo local
# sqlserver = SQL Server real
DATA_SOURCE=sqlserver
DATA_FILE=data/lecturas_mixtas_demo.tsv

# 0 = usar TODA la tabla al reconstruir el modelo
MODEL_MAX_ROWS=0
LATEST_CONTEXT_ROWS=2000
ANOMALY_DEFAULT_LIMIT=500
CYCLE_DEFAULT_LIMIT=20

# Fases operativas
MOVEMENT_SPEED_THRESHOLD=20
STABLE_SPEED_THRESHOLD=1100
POST_STOP_SECONDS=10
STARTUP_GRACE_SECONDS=5

# Advertencia de presion. En v2.2 NO eleva indice_anomalia por si sola.
PRESSURE_WARNING_PERSISTENT_SECONDS=15

# Eventos v2.2: persistencia + histeresis
EVENT_OPEN_THRESHOLD=80
EVENT_MIN_CONSECUTIVE=3
EVENT_MIN_DURATION_SECONDS=5
EVENT_CLOSE_THRESHOLD=60
EVENT_CLOSE_SECONDS=5
EVENT_IMMEDIATE_RULE_THRESHOLD=85
EVENT_MAX_GAP_SECONDS=12

# Ciclos v2.2: p95 + regla fisica + firma robusta del ciclo
CYCLE_SIGNATURE_MIN_BASELINE=12
CYCLE_SIGNATURE_Z_START=2.5
CYCLE_SIGNATURE_Z_HIGH=4.5
CYCLE_INSTANT_PEAK_THRESHOLD=90

# ============================================================
# SQL SERVER
# Misma instancia local usada por el otro proyecto, pero esta
# API trabaja con la base MantenimientoPredictivo.
# ============================================================
SQL_DRIVER=ODBC Driver 17 for SQL Server
SQL_SERVER=USER4710-PC\SQLEXPRESS
SQL_PORT=
SQL_DATABASE=MantenimientoPredictivo
SQL_TABLE=dbo.LecturasTanque

# Autenticacion integrada de Windows.
# Con yes no se necesitan SQL_USERNAME ni SQL_PASSWORD.
SQL_TRUSTED_CONNECTION=yes
SQL_USERNAME=
SQL_PASSWORD=

SQL_ENCRYPT=no
SQL_TRUST_SERVER_CERTIFICATE=yes
SQL_CONNECTION_TIMEOUT=8
SQL_QUERY_TIMEOUT=60
