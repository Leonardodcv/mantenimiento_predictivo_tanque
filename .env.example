# ============================================================
# MANTENIMIENTO PREDICTIVO DEL TANQUE - BACKEND v5.0
# ============================================================

APP_NAME=Mantenimiento Predictivo Tanque API v5.0
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8002

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5174,http://127.0.0.1:5174,http://10.10.17.13:5174,http://10.10.17.17:5174

DATA_SOURCE=sqlserver
DATA_FILE=data/lecturas_mixtas_demo.tsv
MODEL_MAX_ROWS=0
LATEST_CONTEXT_ROWS=2000
ANOMALY_DEFAULT_LIMIT=500
CYCLE_DEFAULT_LIMIT=20

# Fases principales
MOVEMENT_SPEED_THRESHOLD=20
STABLE_SPEED_THRESHOLD=1100
POST_STOP_SECONDS=10
STARTUP_GRACE_SECONDS=5

# v3.x - subestados de reposo
# VACIADO se detecta principalmente por pendiente negativa del nivel.
REST_DRAIN_SLOPE_THRESHOLD=-0.04
REST_STATIC_SLOPE_THRESHOLD=0.02
REST_WAIT_SETPOINT_MARGIN=2.5
REST_MAX_DERIVATIVE_GAP_SECONDS=30

# presion_alta sigue siendo advertencia, no falla directa
PRESSURE_WARNING_PERSISTENT_SECONDS=15

# Eventos persistentes + histeresis
EVENT_OPEN_THRESHOLD=80
EVENT_MIN_CONSECUTIVE=3
EVENT_MIN_DURATION_SECONDS=5
EVENT_CLOSE_THRESHOLD=60
EVENT_CLOSE_SECONDS=5
EVENT_IMMEDIATE_RULE_THRESHOLD=85
EVENT_MAX_GAP_SECONDS=12
# true: REPOSO/VACIADO no abre eventos solo por rareza estadistica.
# Las reglas fisicas fuertes siguen abriendo evento inmediatamente.
EVENT_STATISTICAL_ACTIVE_ONLY=true

# v3.x - reanudacion tras paro prolongado
RESTART_LONG_STOP_HOURS=2
RESTART_STABILIZATION_CYCLES=4
# Durante reanudacion/estabilizacion se conserva indice_ml_crudo,
# pero el indice efectivo se limita salvo que exista una regla fisica real.
RESTART_ML_CAP=39
RESTART_CYCLE_SCORE_CAP=39

# Firma de ciclo: estadistica robusta + tolerancia minima de ingenieria
CYCLE_SIGNATURE_MIN_BASELINE=12
CYCLE_SIGNATURE_Z_START=2.5
CYCLE_SIGNATURE_Z_HIGH=6.0
CYCLE_SIGNATURE_ENGINEERING_HIGH_RATIO=3.0
CYCLE_INSTANT_PEAK_THRESHOLD=90

# v3.1/v3.2 - explicabilidad heuristica del Isolation Forest
# No es atribucion causal; compara cada variable contra el baseline robusto del regimen.
EXPLAIN_MIN_INDEX=70
EXPLAIN_TOP_FEATURES=8
EXPLAIN_MIN_ROBUST_Z=1.5
EXPLAIN_Z_FULL_SCALE=6

# v3.2 - pisos fisicos de escala para evitar z robustos absurdos cuando MAD ~= 0
EXPLAIN_MIN_SCALE_FLOW=0.20
EXPLAIN_MIN_SCALE_PRESSURE=0.10
EXPLAIN_MIN_SCALE_LEVEL=1.0
EXPLAIN_MIN_SCALE_FREQUENCY=1.0
EXPLAIN_MIN_SCALE_SPEED=10
EXPLAIN_MIN_SCALE_OUTPUT_VOLTAGE=2
EXPLAIN_MIN_SCALE_DC_BUS=5
EXPLAIN_MIN_SCALE_L1_VOLTAGE=5
EXPLAIN_MIN_SCALE_L1_CURRENT=0.005
EXPLAIN_MIN_SCALE_ACTIVE_POWER=1
EXPLAIN_MIN_SCALE_APPARENT_POWER=1

# v3.1 - un evento corto puede existir dentro de un ciclo globalmente sano.
# Solo se hereda la rareza ML al estado integral del ciclo si es suficientemente persistente.
CYCLE_ML_INTEGRAL_THRESHOLD=70
CYCLE_ML_PERSISTENCE_FRACTION=0.25
CYCLE_ML_PERSISTENCE_SECONDS=30
CYCLE_TRANSIENT_ML_CAP=39

# Tolerancias minimas de ingenieria.
# Una desviacion debe superar la tolerancia FISICA y ser rara estadisticamente.
CYCLE_TOL_DURATION_ABS_SECONDS=6
CYCLE_TOL_DURATION_PCT=0.08
CYCLE_TOL_LEVEL_START_ABS=2.5
CYCLE_TOL_LEVEL_START_PCT=0.04
CYCLE_TOL_LEVEL_END_ABS=2.5
CYCLE_TOL_LEVEL_END_PCT=0.04
CYCLE_TOL_FLOW_ABS=0.5
CYCLE_TOL_FLOW_PCT=0.03
CYCLE_TOL_PRESSURE_ABS=0.35
CYCLE_TOL_PRESSURE_PCT=0.04
CYCLE_TOL_SPEED_ABS=25
CYCLE_TOL_SPEED_PCT=0.02

# v3.2 - baseline de ciclos protegido/congelado
# v5 migra automaticamente un baseline v4.0 (o v3.2) a artifacts/cycle_baseline_<source>_v50.json.
# Si no existe referencia previa, el primer rebuild v5 crea una nueva referencia protegida.
# Los rebuild siguientes NO incorporan automaticamente ciclos anormales.
CYCLE_BASELINE_MODE=protected_frozen
CYCLE_BASELINE_DIR=artifacts
CYCLE_BASELINE_ACCEPT_MAX_SIGNATURE=39
CYCLE_BASELINE_MAX_ML_FRACTION=0.20
CYCLE_BASELINE_BOOTSTRAP_MIN_CYCLES=20

# v3.2 - detectar un nuevo regimen persistente, pero mantenerlo en cuarentena
NEW_REGIME_MIN_CONSECUTIVE_CYCLES=5
NEW_REGIME_SIGNATURE_TOP_METRICS=2
NEW_REGIME_MAX_GAP_MINUTES=15

# v3.2 - ciclo parcial cuando arranca cerca del setpoint de llenado
CYCLE_PARTIAL_START_SETPOINT_MARGIN=5
CYCLE_PARTIAL_END_SETPOINT_MARGIN=3
CYCLE_PARTIAL_MAX_DURATION_SECONDS=60


# ============================================================
# v4.0 - CONTEXTO FISICO / UNIDADES / ENTRENAMIENTO PROTEGIDO
# ============================================================
# La columna velocidad sigue siendo RAW del VFD hasta confirmar el escalado en TIA/Modbus.
VELOCITY_RPM_CONFIRMED=false

# Mantener false hasta confirmar en TIA el escalado de las entradas analogicas.
FLOW_UNIT_L_MIN_CONFIRMED=false
PRESSURE_UNIT_PSI_CONFIRMED=false

# Referencia fisica PK60: SOLO contexto teorico por defecto, nunca regla de falla.
PUMP_PHYSICS_CONTEXT_ENABLED=true
PUMP_PHYSICS_USE_FOR_RULES=false

# Segunda pasada: ARRANQUE/OPERACION_ESTABLE/DESACELERACION se entrenan
# solamente con ciclos confiables del baseline protegido.
ML_PROTECTED_ACTIVE_TRAINING=true

# Agrupa episodios separados con la misma firma bajo una familia de regimen.
REGIME_FAMILY_ENABLED=true



# ============================================================
# v5.0 - PRUEBAS CONTROLADAS / GROUND TRUTH
# ============================================================
# Catalogo local de bitacora. Las etiquetas NO cambian el indice de anomalia.
CONTROLLED_TRIALS_ENABLED=true
CONTROLLED_TRIALS_FILE=data/controlled_trials_2026-10-08.json

# La sesion 08:10-09:28 se excluye completa porque las pruebas fueron continuas
# y no se debe suponer recuperacion normal entre anotaciones.
CONTROLLED_TRIALS_EXCLUDE_SESSION_FROM_TRAINING=true
CONTROLLED_TRIALS_EXCLUDE_SESSION_FROM_BASELINE=true

# Umbral usado solo para medir si el detector respondio dentro de una ventana anotada.
CONTROLLED_TRIALS_DETECTION_THRESHOLD=70

# ============================================================
# v5.0 - DOS PUNTOS DE PRESION
# ============================================================
# Topologia confirmada:
# sensor_bomba    = entre bomba y valvula superior naranja
# sensor_superior = entre valvula azul superior y tanque
#
# El dataset actual solo tiene `presion_relativa`, por lo que NO se fuerza un
# mapeo fisico. Deja ambos vacios hasta confirmar que columna corresponde a cada sensor.
# Cuando Node-RED/SQL entregue dos columnas, configura los nombres aqui para que
# v5 exponga presion_sensor_bomba, presion_sensor_superior y delta_presion_bomba_a_superior.
PRESSURE_SENSOR_PUMP_COLUMN=
PRESSURE_SENSOR_TANK_COLUMN=

# ============================================================
# SQL SERVER
# ============================================================
SQL_DRIVER=ODBC Driver 17 for SQL Server
SQL_SERVER=USER4710-PC\SQLEXPRESS
SQL_PORT=
SQL_DATABASE=MantenimientoPredictivo
SQL_TABLE=dbo.LecturasTanque

SQL_TRUSTED_CONNECTION=yes
SQL_USERNAME=
SQL_PASSWORD=
SQL_ENCRYPT=no
SQL_TRUST_SERVER_CERTIFICATE=yes
SQL_CONNECTION_TIMEOUT=8
SQL_QUERY_TIMEOUT=60
